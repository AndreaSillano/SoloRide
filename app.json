{
  "expo": {
    "name": "SoloRide",
    "slug": "SoloRide",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "soloride",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "SoloRide uses the camera to add photos to your rides.",
        "NSLocationWhenInUseUsageDescription": "SoloRide uses your location while you record a ride.",
        "NSPhotoLibraryUsageDescription": "SoloRide uses your photo library to add photos to your rides."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SoloRide uses the camera to add photos to your rides.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SoloRide uses your photo library to add photos to your rides.",
          "cameraPermission": "SoloRide uses the camera to add photos to your rides.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SoloRide uses your location while you record a ride.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
