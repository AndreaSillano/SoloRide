{
  "expo": {
    "name": "Rhodeo",
    "slug": "soloride",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "soloride",
    "icon": "./assets/Rhodeo-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fff9f3",
    "primaryColor": "#c6532f",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ef8a4c"
    },

    "ios": {
      "icon": "./assets/RhodeoIcon.icon",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Rhodeo uses the camera to add photos to your rides.",
        "NSLocationWhenInUseUsageDescription": "Rhodeo uses your location to optionally tag photos with where they were taken.",
        "NSMicrophoneUsageDescription": "Rhodeo uses the microphone to attach voice notes to your photos.",
        "NSPhotoLibraryUsageDescription": "Rhodeo uses your photo library to add photos to your rides."
      },
      "bundleIdentifier": "com.anonymous.SoloRide"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ef8a4c"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.SoloRide",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/Rhodeo-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#ef8a4c"
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Rhodeo uses the camera to add photos to your rides.",
          "microphonePermission": "Rhodeo uses the microphone to record sound with your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rhodeo uses your photo library to add photos to your rides.",
          "cameraPermission": "Rhodeo uses the camera to add photos to your rides."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rhodeo uses your location to optionally tag photos with where they were taken.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Rhodeo uses the microphone to attach voice notes to your photos.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b162b64d-8ed0-41b4-a60f-ebba66cd948e"
      }
    },
    "owner": "megaandixs-team"
  }
}
